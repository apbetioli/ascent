# Convex (run `npx convex dev` to set CONVEX_DEPLOYMENT and NEXT_PUBLIC_CONVEX_URL)
# CONVEX_DEPLOYMENT=dev:...
# NEXT_PUBLIC_CONVEX_URL=https://...
# Convex Auth: set SITE_URL, JWT_PRIVATE_KEY, and JWKS in the Convex backend. Easiest:
#   npx @convex-dev/auth
# Or manually: npx convex env set SITE_URL http://localhost:3000
# and generate/set JWT keys (see https://labs.convex.dev/auth/setup/manual).
# SITE_URL is required for payment auto-login (magic link redirect).
# AUTH_RESEND_KEY=...

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Convex HTTP URL for rate limiting (if different from NEXT_PUBLIC_CONVEX_URL)
# Set NEXT_PUBLIC_CONVEX_SITE_URL to your Convex HTTP URL (https://<deployment>.convex.site)
# or derive from NEXT_PUBLIC_CONVEX_URL (replace .convex.cloud with .convex.site)

# App
NEXT_PUBLIC_APP_NAME=Ascent
NEXT_PUBLIC_SUPPORT_EMAIL=contact@apbetioli.dev
NEXT_PUBLIC_PRICE=5
