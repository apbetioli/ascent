# Convex (run `npx convex dev` to set CONVEX_DEPLOYMENT and NEXT_PUBLIC_CONVEX_URL)
# CONVEX_DEPLOYMENT=dev:...
# NEXT_PUBLIC_CONVEX_URL=https://...
# Convex Auth: set SITE_URL, JWT_PRIVATE_KEY, and JWKS in the Convex backend. Easiest:
#   npx @convex-dev/auth
# Or manually: npx convex env set SITE_URL http://localhost:3000
# and generate/set JWT keys (see https://labs.convex.dev/auth/setup/manual).

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Redis (API rate limiting + live visitor count)
# Local dev: run `docker compose -f docker-compose.redis.yml up -d`, then:
#   UPSTASH_REDIS_REST_URL=http://localhost:8079
#   UPSTASH_REDIS_REST_TOKEN=dev_token
# Production: use Upstash (https://upstash.com) and set URL + token from the console
UPSTASH_REDIS_REST_URL=https://...
UPSTASH_REDIS_REST_TOKEN=...

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
